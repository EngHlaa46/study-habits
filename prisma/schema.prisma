generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String?
  passwordHash   String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  profile        UserProfile?
  events         Event[]
  skillProgresses SkillProgress[]
  activePhase    ActivePhase?
  checkIns       CheckIn[]
  chatMessages   ChatMessage[]
  notifications  Notification[]
  pushSubscriptions PushSubscription[]
  feedbacks         Feedback[]
  knowledgeProfile  KnowledgeEntry[]
  skillTrees         SkillTree[]
  assessmentSessions AssessmentSession[]
  queuedActivities   QueuedActivity[]
  weeklyInsights     WeeklyInsight[]
  checkInEntries     CheckInEntry[]
  gameChallenges     GameChallenge[]
  gameSessions       GameSession[]
}

model UserProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyGoal           String?
  typicalStudyHours   Float?
  biggestChallenge    String?
  preferredTime       String?
  phoneDataConsent    Boolean   @default(false)
  selfAssessment      String?   // JSON string of self-assessment answers
  onboardingComplete  Boolean   @default(false)
  inspirationText     String?
  inspirationAt       DateTime?
  personalAffirmation String?
  assessmentText      String?
  assessmentAt        DateTime?
  themePrefs          String?   // JSON: { accentColor: string }
  bannerImageUrl      String?
  bannerPosition      String?   @default("50% 50%")
  coachingStyle       String?   @default("direct")    // direct, socratic
  motivationalFrame   String?   @default("intrinsic") // intrinsic, exam
  phoneUsageHours     Float?                           // avg daily phone screen time (hours)
  calendarFeedUrl     String?                          // iCal feed URL for Google Calendar / Blackboard sync
  calendarLastSynced  DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        String   // exam, quiz, deadline, project, other
  date        DateTime
  status      String   @default("upcoming") // upcoming, passed
  notes       String?
  calendarUid String?  // ICS UID for deduplication on re-sync
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skill {
  id           String          @id @default(cuid())
  slug         String          @unique
  name         String
  level        Int
  description  String
  purpose      String
  icon         String?
  dimension    String?         // planning, behavioral, cognitive
  progresses   SkillProgress[]
}

model SkillProgress {
  id             String   @id @default(cuid())
  userId         String
  skillId        String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill          Skill    @relation(fields: [skillId], references: [id])
  status         String   @default("locked") // locked, available, active, stable, mastered
  weekPhase      Int      @default(0) // 0=not started, 1=stabilize, 2=express, 3=probe
  weekPhaseStart DateTime?
  stabilityScore Float    @default(0)
  userTask              String?   // user-defined task: time/place/action
  notes                 String?
  completionNarrative   String?   // AI-generated growth summary on skill completion
  completionNarrativeAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([userId, skillId])
}

model ActivePhase {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phase         String   @default("onboarding") // onboarding, skill_training
  phaseStart    DateTime @default(now())
  activeEventId String?
  dayCount      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CheckIn {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  initiated    Boolean  @default(false) // did they study?
  focusLevel   String?  // none, brief, focused, deep
  decayPoint   String?  // <10m, 10-25m, 25-45m, 45-60m, no_loss
  contextNote  String?
  atypical     Boolean  @default(false)
  energy       Int?     // 1-5
  mood         Int?     // 1-5
  backfilled        Boolean  @default(false)
  sessionIntention  String?  // pre-session plan (what the user intends to study)
  sessionDuration   Int?     // actual study minutes from timer
  pomodoroCount     Int?     // number of pomodoro cycles completed
  missReason        String?
  studyMethod       String?  // JSON array of method keys
  aiResponses       String?  // JSON: { questions: string[], answers: string[] }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // user, assistant, system
  content   String
  metadata  String?  // JSON string for additional context
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  read      Boolean  @default(false)
  type      String   @default("daily") // daily, weekly
  createdAt DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model KnowledgeEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String   // e.g. "Mathematics", "Biology"
  topic     String   // e.g. "Integration by parts", "Mitosis vs Meiosis"
  status    String   // struggling, developing, mastered
  notes     String?  // specific observations from the AI
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, subject, topic])
}

model SkillTree {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialName String
  generatedAt  DateTime         @default(now())
  nodes        SkillNode[]
  sources      MaterialSource[]
}

model MaterialSource {
  id              String    @id @default(cuid())
  skillTreeId     String
  skillTree       SkillTree @relation(fields: [skillTreeId], references: [id], onDelete: Cascade)
  fileName        String
  markdownContent String
  createdAt       DateTime  @default(now())
}

model SkillNode {
  id                   String    @id @default(cuid())
  skillTreeId          String
  skillTree            SkillTree @relation(fields: [skillTreeId], references: [id], onDelete: Cascade)
  localId              String
  name                 String
  description          String
  whatMasteryLooksLike String
  prerequisites        String    @default("[]")
  suggestedEvalFormat  String
  masteryStatus        String    @default("locked")
  masteryScore         Float     @default(0)
  lastPracticedAt      DateTime?
  nextReviewAt         DateTime?
  reviewInterval       Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model AssessmentSession {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId           String
  createdAt        DateTime @default(now())
  activity         String
  studentResponse  String   @default("")
  masteryDelta     Float    @default(0)
  calibrationScore Float    @default(0)
  strengths        String   @default("")
  weaknesses       String   @default("")
  aiNotes          String   @default("")
}

model QueuedActivity {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId    String
  activity  String
  createdAt DateTime  @default(now())
  servedAt  DateTime?
}

model WeeklyInsight {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekOf         DateTime
  nodesMastered  Int      @default(0)
  weakestConcept String   @default("")
  summary        String
  createdAt      DateTime @default(now())
}

model CheckInEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime
  questions       String   @default("[]")
  responses       String   @default("[]")
  inferredSignals String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
}

model GameChallenge {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy   String        @default("AGENT") // AGENT, SELF
  gameType    String        // QUIZ, MEMORY_SPRINT, TASK_BREAKDOWN
  title       String
  description String
  nodeIds     String        @default("[]") // JSON array of SkillNode IDs
  difficulty  String        @default("MEDIUM") // EASY, MEDIUM, HARD
  dueBy       DateTime?
  status      String        @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, EXPIRED
  score       Float?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  sessions    GameSession[]
}

model GameSession {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId      String?
  challenge        GameChallenge? @relation(fields: [challengeId], references: [id])
  gameType         String         // QUIZ, MEMORY_SPRINT, TASK_BREAKDOWN
  nodeIds          String         @default("[]") // JSON array
  score            Float
  durationSeconds  Int            @default(0)
  questionsTotal   Int?
  questionsCorrect Int?
  detailsJson      String         @default("{}") // JSON
  createdAt        DateTime       @default(now())
}
